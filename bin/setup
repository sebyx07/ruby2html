#!/usr/bin/env ruby
# frozen_string_literal: true

# Sets up (or updates) a development checkout. Idempotent: run it any time,
# e.g. after pulling. Steps: toolchain (mise), gems, C extension, demo app
# database, git hooks.
#
# mise runs at the repo root (mise.toml lives there); bundler, rake and the
# Rails commands run inside apps/ruby2html, where the app + gem now live.
#
#   bin/setup            # everything
#   bin/setup --skip-db  # gem work only (no Rails database)

require 'fileutils'

APP_ROOT = File.expand_path('..', __dir__)
APP_DIR = File.expand_path('apps/ruby2html', APP_ROOT)

def step(title)
  puts "\n== #{title} =="
  yield
end

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  step 'Installing the toolchain (mise)' do
    if system('mise --version', out: File::NULL, err: File::NULL)
      system!('mise install')
    else
      puts 'mise not found: skipped (using the active Ruby)'
    end
  end
end

FileUtils.chdir APP_DIR do
  step 'Installing gems' do
    system('bundle check > /dev/null') || system!('bundle install')
  end

  step 'Compiling the C extension' do
    if RUBY_ENGINE == 'jruby'
      puts 'JRuby: skipped (pure-Ruby implementation)'
    else
      system!('bundle exec rake compile')
    end
  end

  unless ARGV.include?('--skip-db')
    step 'Preparing the demo app database' do
      system!('../../bin/rails db:prepare')
      system!('../../bin/rails log:clear tmp:clear')
    end
  end

  step 'Installing git hooks (lefthook)' do
    git_dir = File.join(APP_ROOT, '.git')
    if File.directory?(git_dir) || File.file?(git_dir)
      system!('bundle exec lefthook install')
    else
      puts 'Not a git checkout: skipped'
    end
  end

  puts <<~TXT

    Ready. Next steps:
      bin/console           IRB with ruby2html loaded (no Rails)
      cd apps/ruby2html     bundler + rake run from the app directory
      bin/rails server      demo app on http://localhost:3000
  TXT
end
