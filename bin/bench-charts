#!/usr/bin/env ruby
# frozen_string_literal: true

# Turns one committed benchmark run into the charts and tables of the README's
# Performance section. Nothing here is typed by hand: every number comes from
# the JSON that `bin/bench-report run` wrote.
#
#   BENCH_TIME=5 bundle exec bin/bench-report run docs/benchmarks/x86_64-linux.json   # measure
#   bin/bench-charts            # rewrite docs/benchmarks/*.svg and the README block
#   bin/bench-charts --check    # exit 1 when either is out of date (spec/ci runs this)
#
# Each chart is written twice (light and dark text on a transparent background);
# the README picks one with <picture>, so it follows the reader's GitHub theme.

require 'json'
require 'time'

ROOT = File.expand_path('..', __dir__)
RESULTS = File.join(ROOT, 'docs/benchmarks/x86_64-linux.json')
OUT_DIR = File.join(ROOT, 'docs/benchmarks')
README = File.join(ROOT, 'README.md')
BLOCK_START = '<!-- bench-charts:start (generated by bin/bench-charts, do not edit) -->'
BLOCK_END = '<!-- bench-charts:end -->'
BLOCK = /#{Regexp.escape(BLOCK_START)}.*?#{Regexp.escape(BLOCK_END)}/m

# ruby2html bars take the series colour, every other engine the neutral one.
THEMES = {
  'light' => { text: '#191919', muted: '#666666', ours: '#257de0', other: '#8f8f8f' },
  'dark' => { text: '#efefef', muted: '#9c9c9c', ours: '#338ced', other: '#7a7a7a' }
}.freeze

WIDTH = 760
LABEL_END = 250 # labels are right-aligned to this x
BAR_START = 260
BAR_MAX = 360
BAR_HEIGHT = 16
ROW_PITCH = 30
FONT = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"

def fmt_num(value)
  return '-' unless value

  value >= 100 ? value.round.to_s.reverse.scan(/\d{1,3}/).join(',').reverse : format('%.2f', value)
end

def xml(text)
  text.to_s.gsub('&', '&amp;').gsub('<', '&lt;').gsub('>', '&gt;').gsub('"', '&quot;')
end

def ours?(label)
  label.match?(/ruby2html|\.html\.rb/i)
end

# One horizontal bar: square at the baseline, rounded at the data end.
def bar_path(y, width)
  r = [4, width / 2.0].min
  format('M%<x>d,%<y>d h%<w>.1f a%<r>.1f,%<r>.1f 0 0 1 %<r>.1f,%<r>.1f v%<v>.1f a%<r>.1f,%<r>.1f 0 0 1 -%<r>.1f,%<r>.1f h-%<w>.1f z',
         x: BAR_START, y: y, w: width - r, r: r, v: BAR_HEIGHT - (2 * r))
end

def legend(theme, y)
  [['ours', 'ruby2html', BAR_START], ['other', 'other engines', BAR_START + 100]].map do |key, name, x|
    %(<rect x="#{x}" y="#{y - 9}" width="10" height="10" rx="2" fill="#{theme[key.to_sym]}"/>) +
      %(<text x="#{x + 16}" y="#{y}" font-size="12" fill="#{theme[:muted]}">#{name}</text>)
  end
end

# bars: [{ label:, value:, text: }], value on one shared axis starting at zero.
def svg(chart, theme)
  bars = chart[:bars]
  mixed = bars.map { |b| ours?(b[:label]) }.uniq.size > 1
  top = mixed ? 78 : 56
  max = bars.map { |b| b[:value] }.max
  out = [%(<svg xmlns="http://www.w3.org/2000/svg" width="#{WIDTH}" height="#{top + (bars.size * ROW_PITCH)}" ) +
         %(viewBox="0 0 #{WIDTH} #{top + (bars.size * ROW_PITCH)}" font-family="#{FONT}" role="img" aria-label="#{xml(chart[:title])}">),
         %(<text x="0" y="16" font-size="14" font-weight="600" fill="#{theme[:text]}">#{xml(chart[:title])}</text>),
         %(<text x="0" y="36" font-size="12" fill="#{theme[:muted]}">#{xml(chart[:subtitle])}</text>)]
  out.concat(legend(theme, 60)) if mixed
  bars.each_with_index do |bar, i|
    y = top + (i * ROW_PITCH)
    width = [BAR_MAX * bar[:value] / max, 2].max
    fill = ours?(bar[:label]) || !mixed ? theme[:ours] : theme[:other]
    weight = mixed && ours?(bar[:label]) ? ' font-weight="600"' : ''
    out << %(<text x="#{LABEL_END}" y="#{y + 12}" font-size="12" text-anchor="end" fill="#{theme[:text]}"#{weight}>#{xml(bar[:label])}</text>)
    out << %(<path d="#{bar_path(y, width)}" fill="#{fill}"/>)
    out << %(<text x="#{format('%.1f', BAR_START + width + 8)}" y="#{y + 12}" font-size="12" fill="#{theme[:text]}">#{xml(bar[:text])}</text>)
  end
  "#{(out << '</svg>').join("\n")}\n"
end

def table(rows)
  fastest = rows.map { |r| r['ips'] }.max
  lines = ['| Benchmark | i/s | ms / call | allocs / call | vs fastest |', '|---|--:|--:|--:|--:|']
  rows.sort_by { |r| -r['ips'] }.each do |r|
    ratio = r['ips'] == fastest ? 'fastest' : format('%.2fx slower', fastest / r['ips'])
    lines << "| #{r['label']} | #{fmt_num(r['ips'])} ± #{format('%.1f', 100.0 * r['ips_sd'] / r['ips'])}% | " \
             "#{format('%.4f', 1000.0 / r['ips'])} | #{fmt_num(r['allocations'])} | #{ratio} |"
  end
  lines
end

def ips_bars(rows)
  rows.sort_by { |r| -r['ips'] }.map { |r| { label: r['label'], value: r['ips'], text: fmt_num(r['ips']) } }
end

def group(report, name)
  rows = report['results'].select { |r| r['group'] == name }
  abort "#{RESULTS} has no '#{name}' results: run bin/bench-report again" if rows.empty?
  rows
end

RENDER_NAMES = { 'erubi' => 'Erubi (compiled ERB)', 'phlex' => 'Phlex', 'ruby2html' => 'ruby2html (C extension)' }.freeze

def render_chart(report)
  rows = group(report, 'render_bench (C ext)').map { |r| r.merge('label' => RENDER_NAMES.fetch(r['label'], r['label'])) }
  pure = group(report, 'render_bench (pure Ruby)').find { |r| r['label'] == 'ruby2html' }
  rows << pure.merge('label' => 'ruby2html (pure Ruby)') if pure
  { file: 'page-render', title: 'Standalone page render (100-item page)',
    subtitle: 'renders per second, higher is better · bench/render_bench.rb',
    alt: "Bar chart of renders per second: #{rows.sort_by { |r| -r['ips'] }.map { |r| "#{r['label']} #{fmt_num(r['ips'])}" }.join(', ')}.",
    bars: ips_bars(rows), table: table(rows) }
end

def rails_chart(report)
  rows = group(report, 'Rails request (C ext)')
  { file: 'rails-requests', title: 'Full Rails request (demo app, /benchmark/* routes)',
    subtitle: 'requests per second, higher is better · bin/bench-report',
    alt: "Bar chart of requests per second: #{rows.sort_by { |r| -r['ips'] }.map { |r| "#{r['label']} #{fmt_num(r['ips'])}" }.join(', ')}.",
    bars: ips_bars(rows), table: table(rows) }
end

def escape_chart(report)
  native = group(report, 'escape_bench (C ext)').select { |r| r['label'].start_with?('escape_html ') }
  pure = group(report, 'escape_bench (pure Ruby)').group_by { |r| r['label'] }.transform_values(&:first)
  rows = native.map do |r|
    slow = pure.fetch(r['label'])
    { input: r['label'].delete_prefix('escape_html '), native: r, pure: slow, ratio: r['ips'] / slow['ips'] }
  end
  lines = ['| Input | C extension i/s | pure Ruby i/s | speedup |', '|---|--:|--:|--:|']
  rows.each do |r|
    cells = [r[:native], r[:pure]].map { |m| "#{fmt_num(m['ips'])} ± #{format('%.1f', 100.0 * m['ips_sd'] / m['ips'])}%" }
    lines << "| #{r[:input]} | #{cells.join(' | ')} | #{format('%.1fx', r[:ratio])} |"
  end
  { file: 'escape-speedup', title: 'escape_html: C extension over pure Ruby',
    subtitle: 'times faster, by input (clean = nothing to escape) · bench/escape_bench.rb',
    alt: "Bar chart of the C extension's speedup over pure Ruby: #{rows.map { |r| "#{r[:input]} #{format('%.1fx', r[:ratio])}" }.join(', ')}.",
    bars: rows.map { |r| { label: r[:input], value: r[:ratio], text: format('%.1fx', r[:ratio]) } }, table: lines }
end

def snapshot_line(meta)
  cpu = meta['cpu'] ? "#{meta['cpu']}, " : ''
  load = meta['load_1m'] ? " The machine's 1-minute load average was #{meta['load_1m']} on #{meta['cpus']} CPU threads when the run ended; ± is each benchmark's own standard deviation." : ''
  "Measured #{Time.parse(meta['time']).utc.strftime('%Y-%m-%d')} on #{cpu}#{meta['arch']} #{meta['os']}, `#{meta['ruby']}`, " \
    "commit `#{meta['sha'].to_s[0, 10]}`, #{meta['bench_time']}s per benchmark, YJIT on where this Ruby has it. " \
    "One run on one machine: compare the bars within a chart, not against another machine.#{load}"
end

def readme_block(report, charts)
  lines = [BLOCK_START, '', snapshot_line(report['meta'])]
  charts.each do |chart|
    lines += ['', '<picture>',
              %(  <source media="(prefers-color-scheme: dark)" srcset="docs/benchmarks/#{chart[:file]}-dark.svg">),
              %(  <img src="docs/benchmarks/#{chart[:file]}-light.svg" alt="#{xml(chart[:alt])}" width="#{WIDTH}">),
              '</picture>', '', *chart[:table]]
  end
  (lines + ['', BLOCK_END]).join("\n")
end

def outputs
  report = JSON.parse(File.read(RESULTS))
  charts = [render_chart(report), rails_chart(report), escape_chart(report)]
  files = charts.flat_map do |chart|
    THEMES.map { |name, theme| [File.join(OUT_DIR, "#{chart[:file]}-#{name}.svg"), svg(chart, theme)] }
  end.to_h
  readme = File.read(README)
  abort "#{README} has no '#{BLOCK_START}' ... '#{BLOCK_END}' block to fill" unless readme.match?(BLOCK)
  files.merge(README => readme.sub(BLOCK) { readme_block(report, charts) })
end

stale = outputs.reject { |path, content| File.file?(path) && File.read(path) == content }
if ARGV.include?('--check')
  exit 0 if stale.empty?
  abort "Out of date: #{stale.keys.map { |p| p.delete_prefix("#{ROOT}/") }.join(', ')}. Run bin/bench-charts and commit the result."
end
Dir.mkdir(OUT_DIR) unless Dir.exist?(OUT_DIR)
stale.each do |path, content|
  File.write(path, content)
  puts "wrote #{path.delete_prefix("#{ROOT}/")}"
end
puts 'up to date' if stale.empty?
