#!/usr/bin/env bash
# one-command check (compile + lint + test) — established by dz-runner setup mode.
# The app + gem live under apps/ruby2html, so bundler/rake/rspec/brakeman run
# from there; lint covers the app tree plus the root bin/ scripts, via the
# ../../bin/rubocop binstub (it pins the moved apps/ruby2html/.rubocop.yml).
set -euo pipefail
cd "$(dirname "$0")/../apps/ruby2html"
bundle exec rake compile && ../../bin/rubocop --parallel . ../../bin && CI=1 bundle exec rspec && ../../bin/brakeman --no-pager
