#!/usr/bin/env bash
# one-command check (audit + lint + test + smoke) — established by dz-runner setup mode.
# Runs the gates that can execute locally without special setup (multiple Ruby versions,
# alternative interpreters, platform-specific runners, or special compiler flags).
# Gates that require special setup (C extension builds with -Werror/sanitizers, matrix
# Ruby/Rails versions, ARM64 platforms, JRuby/TruffleRuby) run only in CI.
set -euo pipefail
cd "$(dirname "$0")/.."
bundle-audit check --update && \
  bundle exec rake compile && \
  bin/rubocop --parallel && \
  CI=1 bundle exec rspec && \
  bin/brakeman --no-pager && \
  bundle exec rake smoke
