#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rubygems'
require 'bundler/setup'

# The newest brakeman released upstream, or nil when rubygems.org cannot be
# reached (offline, proxy, ...) - the scan runs either way.
def latest_brakeman_version
  Gem.latest_spec_for('brakeman').version
rescue StandardError
  nil
end

# The upstream-version check is opt-in (RUBY2HTML_CHECK_LATEST=1): it is a
# live rubygems.org round trip, and the scan must start without one - a CI
# job or an offline machine must not block (or hang until the fetcher
# timeout) before the scan.
def latest_check_requested?
  !ENV.fetch('RUBY2HTML_CHECK_LATEST', '').empty?
end

# Scan with the brakeman locked in Gemfile.lock.
#
# Gemfile.lock lists brakeman as a bare dependency (no version requirement), so
# the lock file is the only constraint there is. Resolve the locked spec
# explicitly instead of Gem.bin_path, which picks up whichever brakeman happens
# to be installed on the machine.
brakeman_spec = Gem.loaded_specs['brakeman']
abort('brakeman is not in the bundle - run `bundle install`') if brakeman_spec.nil?

brakeman_executable = File.join(brakeman_spec.bin_dir, brakeman_spec.executables.first)
abort("brakeman executable missing: #{brakeman_executable}") unless File.exist?(brakeman_executable)

# Never re-add brakeman's "Fail when Brakeman is outdated" option (option key
# ensure_latest) here - its CLI flag is deliberately not spelled out in this
# file, so a grep for it finds no injection point.
#
# Brakeman runs that check BEFORE the scan (Brakeman::Commandline.run calls
# check_latest and only then run_report), so a newer upstream release makes it
# exit with Not_Latest_Version_Exit_Code (5) and the scan never runs at all:
# CI reports "not the latest version" instead of the scan result. A stale but
# valid lock must never turn CI red, and version skew must never mask a red
# scan.
#
# A newer upstream brakeman is reported on stderr only, below - and only when
# the check is requested (RUBY2HTML_CHECK_LATEST=1), because the lookup is a
# live rubygems.org round trip the scan must not wait on (see
# latest_check_requested?). The exit status stays brakeman's own: no warning
# flag is passed, so brakeman's default applies and findings still fail the
# build (Warnings_Found_Exit_Code).
if latest_check_requested?
  latest_version = latest_brakeman_version
  if latest_version && latest_version > brakeman_spec.version
    warn "brakeman #{brakeman_spec.version} is behind the latest release #{latest_version} - the scan ran against the locked version."
  end
end

load brakeman_executable
