#!/usr/bin/env ruby
# frozen_string_literal: true

require 'pathname'

# Audits one resolved lockfile against the Ruby advisory database.
#
#   bin/audit-advisories                       # the lockfile of BUNDLE_GEMFILE, else Gemfile.lock
#   bin/audit-advisories path/to/Gemfile.lock  # an explicit lockfile
#
# The matrix jobs install an unlocked gemfile: ruby/setup-ruby resolves it
# during the job and writes the lockfile next to it (gemfiles/*.lock,
# gitignored, never committed). That resolved set is what the job installs, so
# it is what has to be audited; the committed root Gemfile.lock has its own CI
# job (bundle-audit check --update).
#
# bundle-audit exits 1 when it finds an advisory: this script exits with
# bundle-audit's status, so an advisory fails the CI job. The advisories of the
# floor lines the matrix resolves on purpose are accepted by id (see
# ACCEPTED_ADVISORIES below); every other advisory still fails the job.
#
# bundle-audit resolves --gemfile-lock against its own working directory, so
# the audit runs in the project root and gets the lockfile as a path relative
# to it.

ROOT = File.expand_path('..', __dir__)

# The advisories the audit accepts, per gem and per reviewed version.
#
# The matrix resolves the oldest supported dependency lines on purpose: Rails
# 7.2.x, and Active Support 7.2.x on Ruby 3.1, where Active Support 8 does not
# install. Upstream does not patch those lines any more: every advisory below
# is fixed in a newer line only (8.0.5.2, 8.1.4.1), or in a patch release the
# matrix cannot resolve, because the Rails 7.2 line pins its components to the
# version of the rails release it ships with. The gem itself has no runtime
# dependencies and the demo app that pulls Rails is not part of the package
# (SECURITY.md), so the accepted risk belongs to the demo app, not to the gem.
#
# The exception is scoped to the exact reviewed version: it applies only when
# the lockfile resolves that very version. A moved resolution — a new patch
# release of the line, patched or not — drops every exception and fails the
# audit until the list is reviewed again, so an exception can never outlive
# the version it was reviewed for, and an id that does not apply to the
# resolved version can never be ignored at all.
#
# Reviewed 2026-11-09 (all five components resolve 7.2.3 on the 7.2 line).
# Drop an entry as soon as the matrix resolves a patched version of that line.
ACCEPTED_ADVISORIES = {
  'actionmailbox' => { '7.2.3' => %w[GHSA-5957-c7qm-m469] },
  'actionpack' => { '7.2.3' => %w[
    GHSA-2586-8ghr-69fj
    GHSA-gmj8-hvj3-49mw
    GHSA-r9jg-fmfx-2gv6
    GHSA-rwvh-fw6r-pwvp
    GHSA-wm3x-v3qw-4jh3
    GHSA-x6mj-8jx9-qhqv
  ] },
  'actionview' => { '7.2.3' => %w[
    GHSA-2p2f-4rq4-gjwc
    GHSA-68p9-83h6-5wpj
    GHSA-rq8q-p985-fjq7
    GHSA-v55j-83pf-r9cq
    GHSA-v6rj-xm57-3p59
  ] },
  'activestorage' => { '7.2.3' => %w[
    GHSA-3f4q-8x5m-76v8
    GHSA-3w93-6hmw-whh4
    GHSA-73f9-jhhh-hr5m
    GHSA-9xrj-h377-fr87
    GHSA-f3w6-w445-fwh9
    GHSA-hfr4-8rjc-97m2
    GHSA-p2pm-g2h6-7j5j
    GHSA-p9fm-f462-ggrg
    GHSA-qcfx-2mfw-w4cg
    GHSA-r46p-8f7g-vvvg
    GHSA-v924-7rp8-4mxh
    GHSA-xr9x-r78c-5hrm
  ] },
  'activesupport' => { '7.2.3' => %w[
    GHSA-2j26-frm8-cmj9
    GHSA-8474-xrp6-wh69
    GHSA-89vf-4333-qx8v
    GHSA-cg4j-q9v8-6v38
  ] }
}.freeze

# The child processes must not see the caller's Bundler environment: they read
# the lockfile they are given, not the bundle the caller resolved. GEM_HOME and
# GEM_PATH stay: bundler-audit is installed in and looked up there.
def clean_env
  ENV.to_h.reject { |key, _value| key.match?(/\A(BUNDLE|BUNDLER|RUBYOPT|RUBYLIB)/) }
end

# The lockfile to audit: ARGV[0], else the one Bundler writes next to
# BUNDLE_GEMFILE, else the committed root Gemfile.lock.
def lockfile
  argument = ARGV[0].to_s
  return File.expand_path(argument) unless argument.empty?

  gemfile = ENV['BUNDLE_GEMFILE'].to_s
  return File.expand_path("#{gemfile}.lock") unless gemfile.empty?

  File.join(ROOT, 'Gemfile.lock')
end

# The path bundle-audit gets for the lockfile: it resolves --gemfile-lock
# against its own working directory (File.join(File.expand_path(Dir.pwd),
# value)), so an absolute path never resolves. The audit runs in the project
# root and hands over a path relative to it.
def lockfile_argument(lock)
  Pathname.new(lock).relative_path_from(Pathname.new(ROOT)).to_s
end

# The versions the lockfile resolves: "    gemname (1.2.3)" in its spec list.
def resolved_versions(lock)
  File.foreach(lock).each_with_object({}) do |line, versions|
    match = line.match(/\A {4}(\S+) \(([^)]+)\)\s*\z/)
    versions[match[1]] = match[2] if match
  end
end

# The advisories accepted for this lockfile: an accepted advisory counts only
# when the lockfile resolves its gem at exactly the reviewed version, so an
# accepted id can never hide an advisory in another version of the same line.
def accepted_advisories(lock)
  versions = resolved_versions(lock)

  ACCEPTED_ADVISORIES.filter_map do |gem, reviewed|
    reviewed[versions[gem].to_s]
  end.flatten.uniq
end

# The first executable named cmd on PATH.
def which(cmd, env)
  env.fetch('PATH', '').split(File::PATH_SEPARATOR).each do |dir|
    next if dir.empty?

    path = File.join(dir, cmd)
    return path if File.file?(path) && File.executable?(path)
  end
  nil
end

# Where RubyGems installs executables: that directory is not always on PATH.
def gem_executable(name)
  dirs = %i[default_bindir user_bindir bindir].filter_map do |dir|
    Gem.public_send(dir) if Gem.respond_to?(dir)
  end
  dirs.uniq.map { |dir| File.join(dir, name) }
      .find { |path| File.file?(path) && File.executable?(path) }
end

# The gem executable: on PATH when RubyGems' bin dir is, else in the bindir of
# the running Ruby — which is exactly the setup where bundle-audit is missing
# too (installed into a bindir that PATH does not have).
def gem_installer(env)
  which('gem', env) || gem_executable('gem')
end

env = clean_env
lock = lockfile

abort "audit: no such lockfile: #{lock}" unless File.file?(lock)

exe = which('bundle-audit', env)

unless exe
  puts '== Installing bundler-audit'
  installer = gem_installer(env)
  abort 'audit: no gem executable found to install bundler-audit' unless installer

  abort 'audit: could not install bundler-audit' unless system(env, installer, 'install', '--no-document', 'bundler-audit', unsetenv_others: true)

  exe = which('bundle-audit', env) || gem_executable('bundle-audit')
end

abort 'audit: bundle-audit is not available' if exe.nil?

puts "== Auditing #{lock}"

args = ['check', '--update', '--gemfile-lock', lockfile_argument(lock)]
accepted = accepted_advisories(lock)

unless accepted.empty?
  puts "== Accepting #{accepted.size} reviewed advisories (see bin/audit-advisories):"
  accepted.sort.each { |advisory| puts "   #{advisory}" }
  args += ['--ignore', *accepted]
end

pid = Process.spawn(env, exe, *args, chdir: ROOT, unsetenv_others: true)
_, status = Process.wait2(pid)

if status.signaled?
  # A killed audit is a broken job, not a finding: say so instead of letting a
  # generic exit status pass for an advisory result.
  warn "audit: bundle-audit was terminated by signal #{status.termsig}"
  exit 1
end

exit(status.exitstatus || 1)
