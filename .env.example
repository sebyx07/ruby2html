# Names only, never values. Copy to .env (gitignored) or export them in your shell.
# Nothing here is needed to build, test or run ruby2html: these feed the MCP servers in
# .mcp.json. A server whose variables are unset fails to connect and the rest keep working.

# sentry-mcp
SENTRY_ACCESS_TOKEN=
SENTRY_HOST=

# developerz (https://mcp.developerz.ai)
DEVELOPERZ_API_KEY=
