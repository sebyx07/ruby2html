# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key
*.gem
*.so
# Gem packaging (rake build / rake build:checksum) and release workflow output
/pkg/
/checksums/
/release-notes.md

# C extension build artifacts (rake compile builds in tmp/, extconf in-place builds)
*.o
*.bundle
*.dll
/ext/ruby2html/Makefile
/ext/ruby2html/mkmf.log
/ext/ruby2html/extconf.h
*.dSYM/
compile_commands.json

# JRuby Java escaper build artifacts (rake compile on JRuby; the -java gem
# ships this jar, but it is rebuilt from ext/java and never committed)
*.jar
*.class
.cache/clangd/

# Editors / IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace
.fleet/
.zed/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
\#*\#
.#*

# OS cruft
.DS_Store
Thumbs.db
Desktop.ini

# Ruby tooling
/coverage/
/.yardoc/
/doc/
/vendor/bundle/
.byebug_history
.pry_history
.irb_history
.rspec_status
/spec/examples.txt
.ruby-lsp/
.solargraph.yml

# Profiling / benchmark output
*.prof
*.dump
/bench/results/
/profile/
stackprof-*
perf.data*
*.heapsnapshot

# AI agent local state (shared config in .claude/ IS committed)
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
.aider*
.cursor/
.windsurf/
.codex/

# Matrix gemfiles resolve fresh on every CI run; their lockfiles are not committed.
/gemfiles/*.lock
