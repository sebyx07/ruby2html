# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
apps/ruby2html/db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
apps/ruby2html/vendor/* linguist-vendored
apps/ruby2html/config/credentials/*.yml.enc diff=rails_credentials
apps/ruby2html/config/credentials.yml.enc diff=rails_credentials

# C extension sources: C-aware diffs
*.c diff=cpp
*.h diff=cpp
